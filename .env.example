# ==============================================================================
# SKETCHHUB — Campus Event Operations Platform
# Environment Configuration & Integration Guide (.env.example)
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real secrets, private keys, or API credentials to Git.
# - This file documents all environment variables across 8 distinct operational categories.
# - The application runs in offline 'preview' mode with mock data when these are omitted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION MODE & LOCAL STARTUP
# ------------------------------------------------------------------------------
# Controls whether the platform runs in offline mock preview mode or production mode.
# Values: 'preview' (default, zero credentials needed) | 'production' (strictly requires Supabase)
# Both APP_MODE and NEXT_PUBLIC_APP_MODE are supported (evaluated in src/lib/env.ts).
APP_MODE=preview
# NEXT_PUBLIC_APP_MODE=preview

# Canonical public URL of the web application. Used for absolute links, redirect URIs, and email passes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (LOCAL OR REMOTE)
# ------------------------------------------------------------------------------
# Required when APP_MODE=production.
#
# For local development with Docker:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI... (from `npx supabase status`)
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI... (from `npx supabase status`)
#   Note: Local Supabase PostgreSQL container is on port 54322 (native host Postgres on 5432 is untouched).
#
# For remote Supabase production deployment:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-server-service-role-key

# ------------------------------------------------------------------------------
# 3. ADMIN AUTHENTICATION & BOOTSTRAP
# ------------------------------------------------------------------------------
# Administrative users authenticate via Supabase Auth (email/password or Google OAuth).
# Because Row Level Security revokes direct inserts from public/anon, bootstrap MUST be run
# via the Supabase Dashboard SQL Editor (or using SUPABASE_SERVICE_ROLE_KEY):
#
#   INSERT INTO public.admin_profiles (id, email, full_name, role)
#   VALUES ('<supabase-auth-user-uuid>', 'admin@yourdomain.org', 'Admin Name', 'master_admin');
#
# Supported roles: 'master_admin' | 'event_manager' | 'attendance_staff' | 'analyst'

# ------------------------------------------------------------------------------
# 4. EMAIL PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Provider-neutral transactional email dispatch.
# Values: 'resend' (default/recommended) | 'brevo' | 'mailpit' (local dev, alias 'local') | 'test' (in-memory)
EMAIL_PROVIDER=resend

# Provider API Keys (provide the key matching your EMAIL_PROVIDER selection):
RESEND_API_KEY=re_your_resend_api_key_here
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# ------------------------------------------------------------------------------
# 5. STORAGE & ASSET PERSISTENCE
# ------------------------------------------------------------------------------
# Ticket Studio background images and asset uploads.
# Values: 'supabase' (default/recommended; stores in Supabase Storage bucket 'ticket-assets')
#         'local' (explicit filesystem storage in public/uploads/ for offline preview/tests only)
# In production, 'supabase' is mandatory and filesystem upload will fail closed.
STORAGE_DRIVER=supabase

# ------------------------------------------------------------------------------
# 6. EMAIL SENDER & LOCAL CAPTURE (MAILPIT)
# ------------------------------------------------------------------------------
# Sender identity for registration ticket passes, certificates, and operational announcements.
# Must be an email address on a domain verified in your Resend/Brevo dashboard.
EMAIL_FROM="SketchHUB Events <noreply@yourdomain.org>"

# Optional local Mailpit capture endpoint (used when EMAIL_PROVIDER=mailpit or 'local' in local dev):
# Default: http://127.0.0.1:54324 (matches local Supabase config.toml [local_smtp] port)
# MAILPIT_URL=http://127.0.0.1:54324

# ------------------------------------------------------------------------------
# 6. CRON & OUTBOX WORKER SCHEDULER
# ------------------------------------------------------------------------------
# Shared secret for authenticating the background worker endpoint POST /api/cron/process-outbox.
# Must be a high-entropy string (e.g., generated with `openssl rand -hex 32`).
# IMPORTANT:
# - The endpoint strictly enforces HTTP POST (GET requests return 405 Method Not Allowed to prevent
#   accidental triggers from browser prefetching or URL crawlers).
# - Pass as: Authorization: Bearer <CRON_SECRET> or x-cron-secret: <CRON_SECRET>
CRON_SECRET=your-secure-random-32-byte-hex-secret-here

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH CONFIGURATION (SUPABASE & GOOGLE CLOUD SETTINGS)
# ------------------------------------------------------------------------------
# Google OAuth does not require extra Next.js environment variables.
# Credentials and redirect URIs must be configured across Google Cloud Console and Supabase Dashboard:
#
# A. Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web Application):
#    - Authorized JavaScript Origins:
#        https://your-project-ref.supabase.co
#        https://yourdomain.org (your canonical production URL)
#    - Authorized Redirect URIs:
#        https://your-project-ref.supabase.co/auth/v1/callback
#
# B. Supabase Dashboard > Authentication > Providers > Google:
#    - Toggle Enable Google provider to ON
#    - Client ID: <google-oauth-client-id>
#    - Client Secret: <google-oauth-client-secret>
#
# C. Supabase Dashboard > Authentication > URL Configuration (CRITICAL):
#    - Site URL: https://yourdomain.org (or http://localhost:3000 for local dev)
#    - Redirect URLs (Allow list):
#        https://yourdomain.org/api/auth/callback
#        https://yourdomain.org/**
#        http://localhost:3000/api/auth/callback (if testing locally)
#    Note: In Next.js, the OAuth callback route is handled at /api/auth/callback, which validates
#    that the authenticated user has an active row in public.admin_profiles before granting access.

# ------------------------------------------------------------------------------
# 8. PRODUCTION & HOSTING DEPLOYMENT
# ------------------------------------------------------------------------------
# When deploying to production (e.g. Vercel, Cloud Run):
# - Set APP_MODE=production
# - Set NEXT_PUBLIC_APP_URL to your canonical production URL (e.g. https://sketch.yourdomain.org)
# - Ensure SUPABASE_SERVICE_ROLE_KEY and CRON_SECRET are set as server-only secrets (NOT NEXT_PUBLIC_*)
# - Configure an automated scheduler (Google Cloud Scheduler, Upstash, GitHub Actions) to trigger
#   HTTP POST https://yourdomain.org/api/cron/process-outbox with Bearer <CRON_SECRET> every minute.

# ------------------------------------------------------------------------------
# 9. AUTHENTICATION & SECURITY BOUNDARIES
# ------------------------------------------------------------------------------
# All administrator logins must proceed through verified Supabase Auth (email/password)
# or Google OAuth with an associated roster profile in public.admin_profiles.
#
# Temporary development credentials and preview login bypass
# have been permanently eliminated from the codebase.
#
# Optional session signing key for cryptographic token verification:
# SESSION_SECRET=your-custom-session-signing-key-32-chars-minimum


# ==============================================================================
# SKETCH Event Operations Platform — Environment Variables
# ==============================================================================
# Note: The application runs with mock data by default when these are omitted.
# Supabase credentials are not required merely to run or preview the frontend.

# Application Mode: 'preview' (default, mock data) or 'production' (strictly enforces Supabase)
APP_MODE=preview

# Supabase Configuration (Required when APP_MODE=production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Delivery Configuration (Provider-neutral adapter)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="SKETCH Events <events@sketchevents.org>"
# Optional local Mailpit capture endpoint (used when EMAIL_PROVIDER=mailpit)
# MAILPIT_URL=http://127.0.0.1:54324

# Cron & Outbox Worker Secret (Required for background worker invocation)
CRON_SECRET=your-cron-secret-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

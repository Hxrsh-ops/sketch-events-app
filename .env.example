# ==============================================================================
# SKETCH Event Operations Platform — Environment Variables
# ==============================================================================
# Note: The application runs with mock data by default when these are omitted.
# Supabase credentials are not required merely to run or preview the frontend.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Delivery Configuration (Provider-neutral adapter)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="SKETCH Events <events@sketchevents.org>"

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
